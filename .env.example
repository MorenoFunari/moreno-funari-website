NEXT_PUBLIC_GA_ENABLED=false
NEXT_PUBLIC_META_PIXEL_ENABLED=false
NEXT_PUBLIC_META_PIXEL_ID=

# Brevo — API server-side per i form CONFRONTO e PASSO
BREVO_API_KEY=
BREVO_LIST_ID_PILOT=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
LEAD_NOTIFICATION_TO=

# PASSO: guida #4; marketing facoltativo Community #3. Il vecchio
# BREVO_LIST_ID_PASSO non viene usato per evitare iscrizioni implicite.
BREVO_LIST_ID_PASSO_GUIDE=4
BREVO_LIST_ID_MARKETING=3
BREVO_TEMPLATE_ID_PASSO=

# Percorso commerciale: solo notifica, nessuna lista o automazione Pilot.
# Attivare soltanto dopo conferma privacy/fiscale; lasciare false in produzione.
PERCORSI_LEADS_ENABLED=false
PERCORSI_NOTIFICATION_TO=

# Enable only after specific privacy validation for young-athlete requests.
GIOVANI_ATLETI_LEADS_ENABLED=false
# Optional; falls back to existing commercial notification configuration.
GIOVANI_ATLETI_NOTIFICATION_TO=
